<Project Sdk="Microsoft.NET.Sdk">

	<!-- Published with native AOT in CI, so that a trimming or AOT problem in the libraries fails the build -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PublishAot>true</PublishAot>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Bitvantage.InternetProtocol.NetworkPrefixLookup\Bitvantage.InternetProtocol.NetworkPrefixLookup.csproj" />
		<ProjectReference Include="..\Bitvantage.InternetProtocol.NetworkPrefixLookup.IPNetwork2\Bitvantage.InternetProtocol.NetworkPrefixLookup.IPNetwork2.csproj" />
		<ProjectReference Include="..\Bitvantage.InternetProtocol.NetworkPrefixLookup.MaxMind\Bitvantage.InternetProtocol.NetworkPrefixLookup.MaxMind.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\Test\Data\MaxMind\GeoIP2-Country-Test.mmdb" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
