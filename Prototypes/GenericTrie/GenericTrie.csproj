<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
		<PackageReference Include="Bart.NET" Version="1.2.1" />
		<!-- the published v2 library, as the "current library" in comparisons; the repository now holds v3 -->
		<PackageReference Include="Bitvantage.InternetProtocol.NetworkPrefixLookup" Version="2.0.0" />
	</ItemGroup>
</Project>
